#!/bin/sh
# keybinds — referência rápida dos atalhos configurados.
#
# Seções: macOS (skhd + yabai), Kitty, tmux e Emacs.
# POSIX sh + awk; sem dependências além de `tput` e `tr`. `fzf` e `less` são opcionais.
#
# Para adicionar ou alterar atalhos, edite apenas o bloco `data()` abaixo.
# Formato (campos separados por "|"):
#   S|id|Título|prefixo da seção|subtítulo     inicia uma seção
#   G|Nome do grupo|prefixo do grupo           inicia um grupo (prefixo opcional)
#   K|teclas|descrição|d                       atalho; "d" = direto, ignora o prefixo
#   N|texto                                    observação exibida ao fim da seção
# Linhas vazias e iniciadas por "#" são ignoradas.

set -eu

VERSION="2.0.0"
PROG=${0##*/}

